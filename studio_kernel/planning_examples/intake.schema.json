{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed planning intake 0.1.0 \u2014 transport, not record schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intake_version": {
      "const": "0.1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "identity",
        "sha256"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "risk_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "reversibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "data_sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "privilege": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "operational_dependence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "external_side_effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "novelty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "consequence": {
              "enum": [
                "contained",
                "ordinary",
                "consequential",
                "critical",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "consequence",
            "rationale",
            "fact_ids"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "review_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "RECOMMENDED",
              "CONDITIONAL",
              "INAPPLICABLE",
              "INCOMPLETE"
            ]
          },
          "obligation": {
            "enum": [
              "mandatory",
              "optional",
              "omitted"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "target",
          "review_id",
          "reviewer",
          "fact_ids",
          "status",
          "obligation",
          "reasons"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "oracle_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "forbidden_operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seconds": {
                "type": "integer",
                "minimum": 1
              },
              "attempts": {
                "type": "integer",
                "minimum": 1
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "cost_limit": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "seconds",
              "attempts",
              "tokens",
              "cost_limit",
              "currency"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "grant_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "stop_triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "goal",
          "owner",
          "requirement_ids",
          "oracle_ids",
          "paths",
          "operations",
          "forbidden_operations",
          "budget",
          "depends_on",
          "grant_ids",
          "stop_triggers"
        ]
      }
    }
  },
  "required": [
    "intake_version",
    "project_id",
    "profile_id",
    "created_at",
    "expected_state_revision",
    "candidate",
    "records",
    "risk_dimensions",
    "reviews",
    "tasks"
  ]
}
