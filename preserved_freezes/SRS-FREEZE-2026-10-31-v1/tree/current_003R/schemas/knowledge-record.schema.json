{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/studio-knowledge-003/knowledge-record.schema.json",
  "title": "Studio Knowledge 003 Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "knowledge_category", "name", "description", "applicable_software_types", "preconditions_and_exclusions", "required_inputs", "recommended_actions_or_practices", "dependencies", "expected_deliverables", "verification_requirements", "known_failure_modes", "source_ids", "evidence_classification", "confidence", "limitations", "related_record_ids"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "knowledge_category": {"enum": ["software_types", "engineering_practices", "sdlc_stages", "architecture_patterns", "prompt_patterns", "roadmap_patterns", "verification_gates", "reference_projects"]},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "applicable_software_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "preconditions_and_exclusions": {"type": "string", "minLength": 1},
    "required_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommended_actions_or_practices": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_failure_modes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_classification": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["low", "moderate", "high"]},
    "limitations": {"type": "string", "minLength": 1},
    "related_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "category_specific": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"knowledge_category": {"const": "sdlc_stages"}}}, "then": {"required": ["category_specific"], "properties": {"category_specific": {"$ref": "#/$defs/sdlc_stage"}}}},
    {"if": {"properties": {"knowledge_category": {"const": "prompt_patterns"}}}, "then": {"required": ["category_specific"], "properties": {"category_specific": {"$ref": "#/$defs/prompt_pattern"}}}},
    {"if": {"properties": {"knowledge_category": {"const": "verification_gates"}}}, "then": {"required": ["category_specific"], "properties": {"category_specific": {"$ref": "#/$defs/verification_gate"}}}},
    {"if": {"properties": {"knowledge_category": {"const": "roadmap_patterns"}}}, "then": {"required": ["category_specific"], "properties": {"category_specific": {"$ref": "#/$defs/roadmap_pattern"}}}},
    {"if": {"properties": {"knowledge_category": {"const": "architecture_patterns"}}}, "then": {"required": ["category_specific"], "properties": {"category_specific": {"$ref": "#/$defs/architecture_pattern"}}}},
    {"if": {"properties": {"knowledge_category": {"const": "reference_projects"}}}, "then": {"required": ["category_specific"], "properties": {"category_specific": {"$ref": "#/$defs/reference_project"}}}}
  ],
  "$defs": {
    "nonempty_string_array": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sdlc_stage": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_conditions", "exit_gate", "decision_owners", "mandatory_status", "rollback_rework_path", "deliverables"],
      "properties": {
        "entry_conditions": {"type": "string", "minLength": 1},
        "exit_gate": {"type": "string", "minLength": 1},
        "decision_owners": {"type": "string", "minLength": 1},
        "mandatory_status": {"type": "string", "minLength": 1},
        "rollback_rework_path": {"type": "string", "minLength": 1},
        "deliverables": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "prompt_pattern": {
      "type": "object", "additionalProperties": false,
      "required": ["input_variables", "constraints", "evidence_demands", "output_contract", "stop_approval_triggers"],
      "properties": {
        "input_variables": {"$ref": "#/$defs/nonempty_string_array"},
        "constraints": {"$ref": "#/$defs/nonempty_string_array"},
        "evidence_demands": {"type": "string", "minLength": 1},
        "output_contract": {"$ref": "#/$defs/nonempty_string_array"},
        "stop_approval_triggers": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "verification_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_required", "outcomes", "pass_condition", "fail_condition", "incomplete_condition", "safe_abstention", "candidate_binding"],
      "properties": {
        "evidence_required": {"$ref": "#/$defs/nonempty_string_array"},
        "outcomes": {"const": ["PASS", "FAIL", "INCOMPLETE"]},
        "pass_condition": {"type": "string", "minLength": 1},
        "fail_condition": {"type": "string", "minLength": 1},
        "incomplete_condition": {"type": "string", "minLength": 1},
        "safe_abstention": {"type": "string", "minLength": 1},
        "candidate_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["required_for_pass", "candidate_identity_fields", "execution_record_required"],
          "properties": {
            "required_for_pass": {"const": true},
            "candidate_identity_fields": {"$ref": "#/$defs/nonempty_string_array"},
            "execution_record_required": {"const": true}
          }
        }
      }
    },
    "roadmap_task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "title", "depends_on", "dependency_type", "acceptance_criteria", "evidence_required"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependency_type": {"enum": ["none", "mandatory", "mandatory_if_released", "conditional", "optional"]},
        "acceptance_criteria": {"$ref": "#/$defs/nonempty_string_array"},
        "evidence_required": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "roadmap_pattern": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptance_criteria", "estimation_assumptions", "example_tasks", "risk_first_rule", "task_dependencies"],
      "properties": {
        "acceptance_criteria": {"type": "string", "minLength": 1},
        "estimation_assumptions": {"type": "string", "minLength": 1},
        "example_tasks": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/roadmap_task"}},
        "risk_first_rule": {"type": "string", "minLength": 1},
        "task_dependencies": {"type": "string", "minLength": 1}
      }
    },
    "architecture_option": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "when_applicable", "benefits", "costs", "risks", "excluded_when", "evidence_source_ids", "evidence_classification"],
      "properties": {
        "option_id": {"type": "string", "minLength": 1},
        "when_applicable": {"type": "string", "minLength": 1},
        "benefits": {"$ref": "#/$defs/nonempty_string_array"},
        "costs": {"$ref": "#/$defs/nonempty_string_array"},
        "risks": {"$ref": "#/$defs/nonempty_string_array"},
        "excluded_when": {"$ref": "#/$defs/nonempty_string_array"},
        "evidence_source_ids": {"$ref": "#/$defs/nonempty_string_array"},
        "evidence_classification": {"enum": ["documented_guidance", "synthesis"]}
      }
    },
    "architecture_tradeoff": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "option_a_signal", "option_b_signal"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "option_a_signal": {"type": "string", "minLength": 1},
        "option_b_signal": {"type": "string", "minLength": 1}
      }
    },
    "architecture_pattern": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_policy", "complexity_cost", "threat_assumptions", "options", "tradeoffs", "failure_modes"],
      "properties": {
        "decision_policy": {"const": "context_specific_options_only"},
        "complexity_cost": {"type": "string", "minLength": 1},
        "threat_assumptions": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/architecture_option"}},
        "tradeoffs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/architecture_tradeoff"}},
        "failure_modes": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "reference_file": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "path", "role", "evidence_kind", "execution_status"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["readme", "security_policy", "agent_instructions", "test_source", "ci_workflow", "release_workflow", "other"]},
        "evidence_kind": {"enum": ["repository_documentation", "repository_policy", "authored_test_code", "workflow_configuration"]},
        "execution_status": {"enum": ["not_run", "not_applicable"]}
      }
    },
    "agent_instruction_findings": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "search_scope", "checked_paths", "finding", "evidence_source_ids"],
      "properties": {
        "status": {"enum": ["found", "not_found_within_scope", "not_checked"]},
        "search_scope": {"enum": ["root_paths_only", "complete_tree", "partial"]},
        "checked_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "finding": {"type": "string", "minLength": 1},
        "evidence_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "reference_project": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_url", "repo_commit", "reference_files", "agent_instruction_findings", "test_execution_status", "ci_execution_status", "release_execution_status"],
      "properties": {
        "repository_url": {"type": "string", "format": "uri"},
        "repo_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reference_files": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/reference_file"}},
        "agent_instruction_findings": {"$ref": "#/$defs/agent_instruction_findings"},
        "test_execution_status": {"const": "not_run"},
        "ci_execution_status": {"const": "not_run"},
        "release_execution_status": {"enum": ["not_run", "not_applicable"]}
      }
    }
  }
}
