{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://manus.local/studio-knowledge-003r/rejections-output.schema.json",
  "title":"003R rejection output",
  "type":"object","required":["output_version","input_sha256","rejected_records","feature_decisions","authority_decisions","unsupported_categories","missing_or_unknown_facts","unknown_fact_ids","conflicting_fact_ids","schema_errors","unverified_evidence_facts"],
  "properties":{"output_version":{"const":"1.0.0"},"input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "rejected_records":{"type":"array","items":{"type":"object","required":["record_id","status","rule_id","reason_code"],"properties":{"record_id":{"type":"string"},"status":{"enum":["RECOMMENDED","CONDITIONAL","INAPPLICABLE","INCOMPLETE"]},"rule_id":{"type":"string"},"reason_code":{"type":"string"}},"additionalProperties":true}},
    "feature_decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},"authority_decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},
    "unsupported_categories":{"type":"array","items":{"type":"object","required":["software_type_id","status","rule_id","reason_code"],"properties":{"software_type_id":{"type":"string"},"status":{"const":"INCOMPLETE"},"rule_id":{"const":"R-CATEGORY-001"},"reason_code":{"enum":["UNKNOWN_CATEGORY_ID","KNOWN_NOT_CALIBRATED"]}},"additionalProperties":true}},
    "missing_or_unknown_facts":{"type":"array","items":{"type":"string"}},"unknown_fact_ids":{"type":"array","items":{"type":"string"}},"conflicting_fact_ids":{"type":"array","items":{"type":"string"}},"schema_errors":{"type":"array","items":{"type":"object","required":["path","message"],"properties":{"path":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}},"unverified_evidence_facts":{"type":"array","items":{"type":"string"}}},
  "$defs":{"decision":{"type":"object","required":["decision_id","status","rule_id","reason_code"],"properties":{"decision_id":{"type":"string"},"status":{"enum":["RECOMMENDED","CONDITIONAL","INAPPLICABLE","INCOMPLETE"]},"rule_id":{"type":"string"},"reason_code":{"type":"string"}},"additionalProperties":true}},"additionalProperties":false
}
