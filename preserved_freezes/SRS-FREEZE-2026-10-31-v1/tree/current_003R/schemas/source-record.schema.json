{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/studio-knowledge-003/source-record.schema.json",
  "title": "STUDIO_KNOWLEDGE_003 Source and Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "publisher", "canonical_url", "retrieval_date", "published_or_version_date", "standard_version", "repo_commit", "file_path", "source_type", "claim_locator", "claims_supported", "limitations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "retrieval_date": {"type": "string", "format": "date"},
    "published_or_version_date": {"type": "string"},
    "standard_version": {"type": "string"},
    "repo_commit": {"type": "string"},
    "file_path": {"type": "string"},
    "source_type": {"type": "string", "minLength": 1},
    "claim_locator": {"type": "string", "minLength": 1},
    "claims_supported": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
