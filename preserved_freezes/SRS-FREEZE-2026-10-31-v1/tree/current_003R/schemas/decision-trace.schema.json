{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manus.local/studio-knowledge-003r/decision-trace.schema.json",
  "title": "003R decision trace",
  "type": "object",
  "required": ["trace_version", "input_sha256", "rules_sha256", "dataset_partition_sha256", "descriptive_text_effect", "rule_precedence", "selected_record_trace", "source_exclusions", "dependency_edges", "dependency_gaps", "related_context_edges", "roadmap_task_edges", "notes"],
  "properties": {
    "trace_version": {"const": "1.0.0"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rules_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_partition_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "descriptive_text_effect": {"const": "ignored_non_authoritative_text_not_copied"},
    "rule_precedence": {"type": "array", "items": {"type": "string"}},
    "selected_record_trace": {
      "type": "array",
      "items": {"type": "object", "required": ["record_id", "rule_id", "predicate_matches", "scope_conditions", "evidence_paths"], "properties": {"record_id": {"type": "string"}, "rule_id": {"type": "string"}, "predicate_matches": {"type": "array"}, "scope_conditions": {"type": "object"}, "evidence_paths": {"type": "array", "minItems": 1}}, "additionalProperties": false}
    },
    "source_exclusions": {
      "type": "array",
      "items": {"type": "object", "required": ["record_id", "software_type_id", "source_id", "claim_locator", "source_type", "rule_id", "reason_code", "rationale"], "properties": {"record_id": {"type": "string"}, "software_type_id": {"type": "string"}, "source_id": {"type": "string"}, "claim_locator": {"type": "string", "minLength": 1}, "source_type": {"type": "string"}, "rule_id": {"const": "R-SCOPE-001"}, "reason_code": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": false}
    },
    "dependency_edges": {
      "type": "array",
      "items": {"type": "object", "required": ["from_record_id", "to_record_id", "predicate", "relationship_id", "status", "dependency_kind", "source_paths"], "properties": {"from_record_id": {"type": "string"}, "to_record_id": {"type": "string"}, "predicate": {"enum": ["requires", "verified_by", "produces"]}, "relationship_id": {"type": "string"}, "status": {"enum": ["LINKED", "INCOMPLETE"]}, "dependency_kind": {"enum": ["hard_prerequisite", "verification_obligation", "produced_output"]}, "source_paths": {"type": "array"}}, "additionalProperties": false}
    },
    "dependency_gaps": {"type": "array", "items": {"type": "string"}},
    "related_context_edges": {
      "type": "array",
      "items": {"type": "object", "required": ["from_record_id", "related_record_id", "dependency_kind"], "properties": {"from_record_id": {"type": "string"}, "related_record_id": {"type": "string"}, "software_type_id": {"type": "string"}, "dependency_kind": {"const": "related_context_not_prerequisite"}, "origin": {"enum": ["typed_relationship", "related_record_ids_field"]}, "predicate": {"const": "informs"}, "relationship_id": {"type": "string"}, "status": {"enum": ["LINKED", "CONTEXT_ONLY"]}, "source_paths": {"type": "array", "items": {"type": "object", "required": ["source_id", "claim_locator", "source_type"], "properties": {"source_id": {"type": "string"}, "claim_locator": {"type": ["string", "null"]}, "source_type": {"type": ["string", "null"]}, "evidence_classification": {"type": ["string", "null"]}}, "additionalProperties": false}}}, "additionalProperties": false}
    },
    "roadmap_task_edges": {
      "type": "array",
      "items": {"type": "object", "required": ["task_id", "depends_on", "dependency_type"], "properties": {"task_id": {"type": "string"}, "depends_on": {"type": "array"}, "dependency_type": {"type": ["string", "null"]}}, "additionalProperties": false}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
